; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="PokemonAutoChess"
config/name_localized={
"zh": "宝可梦自走棋"
}
config/description="A Pokemon themed Auto-Chess strategy game built with Godot 4."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/units/pikachu.jpg"

[autoload]

AudioManager="*res://scripts/autoload/audio_manager.gd"
PokemonDatabase="*res://scripts/autoload/pokemon_database.gd"
TypeSystem="*res://scripts/autoload/type_system.gd"
AbilityDatabase="*res://scripts/autoload/ability_database.gd"
SynergyManager="*res://scripts/autoload/synergy_manager.gd"
ShinyAndLoreManager="*res://scripts/autoload/shiny_and_lore_manager.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
AugmentDatabase="*res://scripts/autoload/augment_database.gd"
ItemDatabase="*res://scripts/autoload/item_database.gd"
WeatherSystem="*res://scripts/autoload/weather_system.gd"
MegaDatabase="*res://scripts/autoload/mega_database.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="PokemonAutoChess"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
shader_compiler/shader_cache/enabled=false
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.13, 1)

[gui]

theme/custom="res://assets/theme/default_theme.tres"
theme/custom_font="res://assets/fonts/main_font.tres"
